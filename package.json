{
    "name": "caprover",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "disable-otp": "node ./built/scripts/disable-otp.js",
        "dev": "sudo 'echo' && npm run build && sudo ./dev-scripts/dev-reset-service.sh",
        "clean": "npm run build && sudo ./dev-scripts/dev-clean-run-as-dev.sh",
        "lint": "eslint 'src/**/*.ts'",
        "lint-fix": "eslint --fix 'src/**/*.ts'",
        "formatter": "prettier --check './src/**/*.ts'",
        "formatter-write": "prettier --write './src/**/*.ts'",
        "build": "echo 'RECOMPILING' && npx madge --circular --extensions ts ./ && rm -rf ./built && npx tsc && echo 'Build successful'",
        "test": "jest",
        "test:disk-docker": "node dev-scripts/test-disk-usage-bind-mount.js"
    },
    "dependencies": {
        "@simplewebauthn/server": "^14.0.3",
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.4.0",
        "configstore": "^5.0.1",
        "cookie-parser": "~1.4.7",
        "cron": "^4.4.0",
        "debug": "~4.4.3",
        "dockerode": "^5.0.1",
        "ejs": "^7.0.2",
        "express": "^5.3.0",
        "fs-extra": "^11.4.1",
        "http-proxy": "^1.18.1",
        "is-valid-path": "^0.1.1",
        "js-base64": "^3.9.4",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "multer": "^2.5.0",
        "on-finished": "^2.4.2",
        "public-ip": "^8.0.0",
        "require-from-string": "^2.0.2",
        "serve-favicon": "~2.5.1",
        "shell-quote": "^1.12.0",
        "simple-git": "^4.0.2",
        "ssh2": "^1.17.0",
        "tar": "^7.5.22",
        "uuid": "^11.1.1",
        "validator": "^13.15.35",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/configstore": "^5.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/debug": "^4.1.13",
        "@types/dockerode": "^4.0.2",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/http-proxy": "^1.17.17",
        "@types/is-valid-path": "^0.1.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.3.0",
        "@types/on-finished": "^2.3.5",
        "@types/require-from-string": "^1.2.3",
        "@types/serve-favicon": "^2.5.7",
        "@types/shell-quote": "^1.7.5",
        "@types/ssh2": "^1.15.6",
        "@types/validator": "^13.15.10",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "madge": "^8.0.0",
        "prettier": "3.9.10",
        "ts-jest": "^29.4.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    }
}
