###CapRoverTheme.name:
Ember

###CapRoverTheme.content:
{
    algorithm: isDarkMode ? darkAlgorithm : defaultAlgorithm,
    token: {
        fontFamily: "'IBM Plex Sans', Arial, sans-serif",
        fontFamilyCode: "'IBM Plex Mono', Consolas, monospace",
        fontSize: 14,
        fontSizeHeading1: 42,
        fontSizeHeading2: 36,
        fontSizeHeading3: 34,
        fontSizeHeading4: 30,
        fontSizeHeading5: 16,
        fontWeightStrong: 600,
        colorPrimary: isDarkMode ? '#E5A173' : '#9F4B22',
        colorPrimaryHover: isDarkMode ? '#E9AF88' : '#92451F',
        colorPrimaryActive: isDarkMode ? '#D0936A' : '#863F1D',
        colorLink: isDarkMode ? '#ECB896' : '#9F4B22',
        colorLinkHover: isDarkMode ? '#EEC2A4' : '#92451F',
        colorLinkActive: isDarkMode ? '#E5A173' : '#863F1D',
        colorBgLayout: isDarkMode ? '#171616' : '#F6F1EC',
        colorBgContainer: isDarkMode ? '#25211F' : '#FFFCF8',
        colorBgElevated: isDarkMode ? '#312925' : '#FFF9F3',
        colorBgSpotlight: isDarkMode ? '#312925' : '#171616',
        colorBgContainerDisabled: isDarkMode ? '#3A2E29' : '#F8EAE0',
        colorText: isDarkMode ? '#F7EAE0' : '#342B28',
        colorTextSecondary: isDarkMode ? '#C0AA9B' : '#76655E',
        colorTextPlaceholder: isDarkMode ? '#C0AA9B' : '#76655E',
        colorTextDisabled: isDarkMode ? '#C0AA9B' : '#76655E',
        colorTextLightSolid: '#FFFFFF',
        colorBorder: isDarkMode ? '#57433A' : '#E0D1C6',
        colorBorderSecondary: isDarkMode ? '#413630' : '#EDE2DA',
        colorFillAlter: isDarkMode ? '#3A2E29' : '#F8EAE0',
        colorBgTextHover: isDarkMode ? '#3A2E29' : '#F8EAE0',
        colorBgTextActive: isDarkMode ? '#50352B' : '#F5E1D3',
        colorSuccess: isDarkMode ? '#6ADEAE' : '#1E7452',
        colorSuccessText: isDarkMode ? '#6ADEAE' : '#1E7452',
        colorSuccessBg: isDarkMode ? '#16372A' : '#E8F5ED',
        colorSuccessBorder: isDarkMode ? '#357757' : '#A7D9BE',
        colorWarning: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningText: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningBg: isDarkMode ? '#3B301C' : '#FFF5DD',
        colorWarningBorder: isDarkMode ? '#8C6931' : '#E5C37C',
        colorError: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorHover: isDarkMode ? '#FF949E' : '#A62032',
        colorErrorActive: isDarkMode ? '#E87681' : '#971D2D',
        colorErrorText: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorBg: isDarkMode ? '#402128' : '#FDEBEC',
        colorErrorBorder: isDarkMode ? '#9A4251' : '#E6A9B1',
        colorInfo: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoText: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoBg: isDarkMode ? '#1B3548' : '#E9F4FE',
        colorInfoBorder: isDarkMode ? '#3D789A' : '#A5C9E7',
        borderRadius: 3,
        borderRadiusLG: 6,
        borderRadiusSM: 2,
        lineWidth: 1,
        lineType: 'solid',
        controlHeight: 38,
        controlOutline: isDarkMode ? '#E5A173' : '#9F4B22',
        controlOutlineWidth: 2,
        lineWidthFocus: 2,
        controlItemBgHover: isDarkMode ? '#3A2E29' : '#F8EAE0',
        controlItemBgActive: isDarkMode ? '#50352B' : '#F5E1D3',
        boxShadow: isDarkMode ? '0 18px 36px rgba(0,0,0,0.38)' : '0 14px 28px rgba(70,37,20,0.15)',
        boxShadowSecondary: isDarkMode ? '0 18px 36px rgba(0,0,0,0.38)' : '0 14px 28px rgba(70,37,20,0.15)',
        boxShadowTertiary: isDarkMode ? '0 3px 10px rgba(0,0,0,0.25)' : '0 2px 8px rgba(65,32,18,0.10)',
    },
    components: {
        Layout: {
            headerBg: isDarkMode ? '#25211F' : '#FFFCF8',
            siderBg: isDarkMode ? '#1C1A19' : '#EFE7E0',
            lightSiderBg: isDarkMode ? '#1C1A19' : '#EFE7E0',
            triggerBg: isDarkMode ? '#1C1A19' : '#EFE7E0',
            lightTriggerBg: isDarkMode ? '#1C1A19' : '#EFE7E0',
            footerBg: isDarkMode ? '#1C1A19' : '#EFE7E0',
        },
        Menu: {
            itemBg: 'transparent',
            popupBg: isDarkMode ? '#312925' : '#FFF9F3',
            itemColor: isDarkMode ? '#F7EAE0' : '#342B28',
            itemHoverBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            itemHoverColor: isDarkMode ? '#F7EAE0' : '#342B28',
            itemSelectedBg: isDarkMode ? '#50352B' : '#F5E1D3',
            itemSelectedColor: isDarkMode ? '#E5A173' : '#9F4B22',
            itemHeight: 40,
            itemMarginInline: 8,
            itemMarginBlock: 2,
            itemBorderRadius: 3,
        },
        Tree: {
            titleHeight: 36,
            nodeHoverBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            nodeHoverColor: isDarkMode ? '#F7EAE0' : '#342B28',
            nodeSelectedBg: isDarkMode ? '#50352B' : '#F5E1D3',
            nodeSelectedColor: isDarkMode ? '#E5A173' : '#9F4B22',
            directoryNodeSelectedBg: isDarkMode ? '#50352B' : '#F5E1D3',
            directoryNodeSelectedColor: isDarkMode ? '#E5A173' : '#9F4B22',
        },
        Card: {
            headerBg: isDarkMode ? '#25211F' : '#FFFCF8',
            headerHeight: 48,
            headerFontSize: 15,
            bodyPadding: 22,
            headerPadding: 22,
            extraColor: isDarkMode ? '#C0AA9B' : '#76655E',
        },
        Table: {
            headerBg: isDarkMode ? '#171616' : '#F6F1EC',
            headerColor: isDarkMode ? '#C0AA9B' : '#76655E',
            headerSplitColor: isDarkMode ? '#413630' : '#EDE2DA',
            borderColor: isDarkMode ? '#413630' : '#EDE2DA',
            rowHoverBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            rowSelectedBg: isDarkMode ? '#50352B' : '#F5E1D3',
            rowSelectedHoverBg: isDarkMode ? '#50352B' : '#F5E1D3',
            bodySortBg: 'transparent',
            headerSortActiveBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            cellPaddingBlockMD: 13,
            cellPaddingInlineMD: 16,
        },
        Button: {
            fontWeight: 500,
            dangerColor: isDarkMode ? '#171616' : '#FFFFFF',
            primaryColor: isDarkMode ? '#171616' : '#FFFFFF',
            primaryShadow: isDarkMode ? '0 2px 0 rgba(0,0,0,0.40)' : '0 2px 0 rgba(85,38,18,0.28)',
            defaultShadow: 'none',
            dangerShadow: 'none',
            defaultBg: isDarkMode ? '#25211F' : '#FFFCF8',
            defaultColor: isDarkMode ? '#F7EAE0' : '#342B28',
            defaultBorderColor: isDarkMode ? '#57433A' : '#E0D1C6',
            defaultHoverColor: isDarkMode ? '#E5A173' : '#9F4B22',
            defaultHoverBorderColor: isDarkMode ? '#E5A173' : '#9F4B22',
            defaultActiveColor: isDarkMode ? '#E5A173' : '#9F4B22',
            defaultActiveBorderColor: isDarkMode ? '#E5A173' : '#9F4B22',
            paddingInline: 12,
        },
        Input: {
            activeBg: isDarkMode ? '#25211F' : '#FFFCF8',
            hoverBg: isDarkMode ? '#25211F' : '#FFFCF8',
            addonBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            hoverBorderColor: isDarkMode ? '#E5A173' : '#9F4B22',
            activeBorderColor: isDarkMode ? '#E5A173' : '#9F4B22',
            activeShadow: isDarkMode ? '0 0 0 2px rgba(229,161,115,0.5)' : '0 0 0 2px rgba(159,75,34,0.42)',
        },
        Select: {
            selectorBg: isDarkMode ? '#25211F' : '#FFFCF8',
            optionSelectedBg: isDarkMode ? '#50352B' : '#F5E1D3',
            optionSelectedColor: isDarkMode ? '#E5A173' : '#9F4B22',
            optionActiveBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            hoverBorderColor: isDarkMode ? '#E5A173' : '#9F4B22',
            activeBorderColor: isDarkMode ? '#E5A173' : '#9F4B22',
            activeOutlineColor: isDarkMode ? '#E5A173' : '#9F4B22',
        },
        Tabs: {
            titleFontSize: 14,
            horizontalItemGutter: 22,
            inkBarColor: isDarkMode ? '#E5A173' : '#9F4B22',
            itemSelectedColor: isDarkMode ? '#E5A173' : '#9F4B22',
            itemHoverColor: isDarkMode ? '#E5A173' : '#9F4B22',
        },
        Tag: {
            defaultBg: isDarkMode ? '#3A2E29' : '#F8EAE0',
            defaultColor: isDarkMode ? '#F7EAE0' : '#342B28',
        },
        Form: {
            labelColor: isDarkMode ? '#F7EAE0' : '#342B28',
            itemMarginBottom: 18,
        },
        Modal: {
            headerBg: isDarkMode ? '#312925' : '#FFF9F3',
            contentBg: isDarkMode ? '#312925' : '#FFF9F3',
            footerBg: isDarkMode ? '#312925' : '#FFF9F3',
            titleColor: isDarkMode ? '#F7EAE0' : '#342B28',
            titleFontSize: 18,
            paddingMD: 22,
            paddingContentHorizontalLG: 22,
        },
        Alert: {
            defaultPadding: '10px 14px',
            withDescriptionPadding: '16px 20px',
        },
        Badge: {
            statusSize: 7,
        },
    },
}

###CapRoverTheme.headEmbed:
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&amp;family=Barlow+Semi+Condensed:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600;700&amp;display=swap" />
<style>
html[data-caprover-theme="ember"] {
    --caprover-shell-radius: 6px;
    --caprover-surface-radius: 6px;
    --caprover-control-radius: 3px;
    --caprover-border-width: 1px;
    --caprover-surface-shadow: 0 2px 10px rgba(85, 38, 18, 0.06);
    --caprover-heading-tracking: 0.01em;
    --caprover-heading-weight: 600;
}
html[data-caprover-theme="ember"][data-caprover-dark="true"] {
    --caprover-surface-shadow: 0 2px 10px rgba(0, 0, 0, 0.16);
}
html[data-caprover-theme="ember"] .page-heading h1,
html[data-caprover-theme="ember"] .apps-heading h1,
html[data-caprover-theme="ember"] .app-details-heading h2 {
    font-family: 'Barlow Semi Condensed', Arial, sans-serif;
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.2;
}
html[data-caprover-theme="ember"] .workspace-header,
html[data-caprover-theme="ember"] .sidebar-brand {
    height: 52px;
}
html[data-caprover-theme="ember"] .sidebar-brand {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-size: 23px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
html[data-caprover-theme="ember"] .sidebar-content .ant-menu-item {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-size: 18px;
}
html[data-caprover-theme="ember"] .sidebar-content .ant-menu-item-selected {
    border-inline-start: 4px solid var(--ant-color-primary);
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.08);
}
html[data-caprover-theme="ember"] .apps-heading h1,
html[data-caprover-theme="ember"] .page-heading h1 {
    text-transform: uppercase;
}
html[data-caprover-theme="ember"] .apps-page > .ant-card-head {
    padding: 20px;
    border: 1px solid var(--ant-color-border);
    border-bottom-width: 3px;
    border-radius: 6px;
    background: var(--ant-color-bg-layout);
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.06);
}
html[data-caprover-theme="ember"] .project-manager {
    padding: 12px;
    border: 1px solid var(--ant-color-border);
    border-radius: 4px;
    background: var(--ant-color-bg-layout);
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.06);
}
html[data-caprover-theme="ember"] .apps-page .ant-table-thead > tr > th {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}
html[data-caprover-theme="ember"] .ant-input,
html[data-caprover-theme="ember"] .ant-input-affix-wrapper,
html[data-caprover-theme="ember"] .ant-select-selector {
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.07);
}
html[data-caprover-theme="ember"] .ant-input-affix-wrapper > .ant-input,
html[data-caprover-theme="ember"] .ant-input-affix-wrapper > .ant-input:focus {
    box-shadow: none;
}
html[data-caprover-theme="ember"] .ant-input:focus,
html[data-caprover-theme="ember"] .ant-input-affix-wrapper-focused,
html[data-caprover-theme="ember"] .ant-select-focused .ant-select-selector {
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.07), 0 0 0 2px var(--ant-color-primary);
}
html[data-caprover-theme="ember"] .ant-btn-primary {
    box-shadow: 0 3px 0 var(--ant-color-primary-active);
}
html[data-caprover-theme="ember"] .metric-value {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-size: 38px;
    font-variant-numeric: tabular-nums;
}
html[data-caprover-theme="ember"] .form-section-title {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-size: 22px;
    text-transform: uppercase;
}
html[data-caprover-theme="ember"] .app-details-actions {
    border-top-width: 3px;
}
@media (max-width: 767px) {
    html[data-caprover-theme="ember"] #main-content-layout {
        padding: 24px 16px;
    }
    html[data-caprover-theme="ember"] .app-shell.full-screen {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        gap: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="ember"] .workspace-layout {
        border: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="ember"] .apps-page > .ant-card-head {
        padding: 0 0 20px;
    }
}
</style>

###CapRoverTheme.extra:
{}
