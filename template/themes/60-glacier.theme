            itemMarginBlock: 2,
            itemBorderRadius: 12,
        },
        Tree: {
            titleHeight: 36,
            nodeHoverBg: isDarkMode ? '#1C3B4B' : '#EAF7FD',
            nodeHoverColor: isDarkMode ? '#E9F9FF' : '#1D354B',
            nodeSelectedBg: isDarkMode ? '#1B4659' : '#D7F2FC',
            nodeSelectedColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            directoryNodeSelectedBg: isDarkMode ? '#1B4659' : '#D7F2FC',
            directoryNodeSelectedColor: isDarkMode ? '#7DE4F7' : '#006B9B',
        },
        Card: {
            headerBg: isDarkMode ? '#112838' : '#F9FDFF',
            headerHeight: 52,
            headerFontSize: 15,
            bodyPadding: 24,
            headerPadding: 24,
            extraColor: isDarkMode ? '#9BC5D8' : '#587186',
        },
        Table: {
            headerBg: isDarkMode ? '#081824' : '#EBF4FA',
            headerColor: isDarkMode ? '#9BC5D8' : '#587186',
            headerSplitColor: isDarkMode ? '#244759' : '#DDEAF3',
            borderColor: isDarkMode ? '#244759' : '#DDEAF3',
            rowHoverBg: isDarkMode ? '#1C3B4B' : '#EAF7FD',
            rowSelectedBg: isDarkMode ? '#1B4659' : '#D7F2FC',
            rowSelectedHoverBg: isDarkMode ? '#1B4659' : '#D7F2FC',
            bodySortBg: 'transparent',
            headerSortActiveBg: isDarkMode ? '#1C3B4B' : '#EAF7FD',
            cellPaddingBlockMD: 14,
            cellPaddingInlineMD: 16,
        },
        Button: {
            fontWeight: 500,
            dangerColor: isDarkMode ? '#081824' : '#FFFFFF',
            primaryColor: isDarkMode ? '#081824' : '#FFFFFF',
            primaryShadow: 'none',
            defaultShadow: 'none',
            dangerShadow: 'none',
            defaultBg: isDarkMode ? '#112838' : '#F9FDFF',
            defaultColor: isDarkMode ? '#E9F9FF' : '#1D354B',
            defaultBorderColor: isDarkMode ? '#315669' : '#C7DCEB',
            defaultHoverColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            defaultHoverBorderColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            defaultActiveColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            defaultActiveBorderColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            paddingInline: 14,
        },
        Input: {
            activeBg: isDarkMode ? '#112838' : '#F9FDFF',
            hoverBg: isDarkMode ? '#112838' : '#F9FDFF',
            addonBg: isDarkMode ? '#1C3B4B' : '#EAF7FD',
            hoverBorderColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            activeBorderColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            activeShadow: isDarkMode ? '0 0 0 3px rgba(125,228,247,0.25)' : '0 0 0 3px rgba(0,107,155,0.23)',
        },
        Select: {
            selectorBg: isDarkMode ? '#112838' : '#F9FDFF',
            optionSelectedBg: isDarkMode ? '#1B4659' : '#D7F2FC',
            optionSelectedColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            optionActiveBg: isDarkMode ? '#1C3B4B' : '#EAF7FD',
            hoverBorderColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            activeBorderColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            activeOutlineColor: isDarkMode ? '#7DE4F7' : '#006B9B',
        },
        Tabs: {
            titleFontSize: 14,
            horizontalItemGutter: 26,
            inkBarColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            itemSelectedColor: isDarkMode ? '#7DE4F7' : '#006B9B',
            itemHoverColor: isDarkMode ? '#7DE4F7' : '#006B9B',
        },
        Tag: {
            defaultBg: isDarkMode ? '#1C3B4B' : '#EAF7FD',
            defaultColor: isDarkMode ? '#E9F9FF' : '#1D354B',
        },
        Form: {
            labelColor: isDarkMode ? '#E9F9FF' : '#1D354B',
            itemMarginBottom: 22,
        },
        Modal: {
            headerBg: isDarkMode ? '#1D3B4A' : '#FFFFFF',
            contentBg: isDarkMode ? '#1D3B4A' : '#FFFFFF',
