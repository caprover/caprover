        colorErrorText: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorBg: isDarkMode ? '#402128' : '#FDEBEC',
        colorErrorBorder: isDarkMode ? '#9A4251' : '#E6A9B1',
        colorInfo: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoText: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoBg: isDarkMode ? '#1B3548' : '#E9F4FE',
        colorInfoBorder: isDarkMode ? '#3D789A' : '#A5C9E7',
        borderRadius: 12,
        borderRadiusLG: 16,
        borderRadiusSM: 8,
        lineWidth: 1,
        lineType: 'solid',
        controlHeight: 38,
        controlOutline: isDarkMode ? '#7DE4F7' : '#006B9B',
        controlOutlineWidth: 2,
        lineWidthFocus: 2,
        controlItemBgHover: isDarkMode ? '#1C3B4B' : '#EAF7FD',
        controlItemBgActive: isDarkMode ? '#1B4659' : '#D7F2FC',
        boxShadow: isDarkMode ? '0 20px 52px rgba(0,0,0,0.40)' : '0 18px 48px rgba(23,77,111,0.18)',
        boxShadowSecondary: isDarkMode ? '0 20px 52px rgba(0,0,0,0.40)' : '0 18px 48px rgba(23,77,111,0.18)',
        boxShadowTertiary: isDarkMode ? '0 10px 30px rgba(0,0,0,0.25)' : '0 6px 24px rgba(18,93,133,0.10)',
    },
    components: {
        Layout: {
            headerBg: isDarkMode ? '#112838' : '#F9FDFF',
            siderBg: isDarkMode ? '#132C3B' : '#E5F1F8',
            lightSiderBg: isDarkMode ? '#132C3B' : '#E5F1F8',
            triggerBg: isDarkMode ? '#132C3B' : '#E5F1F8',
            lightTriggerBg: isDarkMode ? '#132C3B' : '#E5F1F8',
            footerBg: isDarkMode ? '#132C3B' : '#E5F1F8',
        },
