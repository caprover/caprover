        },
    },
}

###CapRoverTheme.headEmbed:
<style>
html[data-caprover-theme="glacier"] {
    --caprover-shell-radius: 18px;
    --caprover-surface-radius: 14px;
    --caprover-control-radius: 8px;
    --caprover-border-width: 1px;
    --caprover-surface-shadow: 0 4px 18px rgba(18, 93, 133, 0.08);
    --caprover-heading-tracking: -0.02em;
    --caprover-heading-weight: 550;
}
html[data-caprover-theme="glacier"][data-caprover-dark="true"] {
    --caprover-surface-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
}
html[data-caprover-theme="glacier"] .app-shell,
html[data-caprover-theme="glacier"] .navigation-drawer {
    background-image:
        radial-gradient(ellipse at 0% 15%, rgba(28, 142, 190, 0.28), transparent 65%),
        radial-gradient(ellipse at 18% 90%, rgba(49, 169, 179, 0.18), transparent 60%);
}
html[data-caprover-theme="glacier"] .app-sidebar,
html[data-caprover-theme="glacier"] .navigation-drawer {
    background-color: rgba(229, 241, 248, 0.86);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
}
html[data-caprover-theme="glacier"][data-caprover-dark="true"] .app-sidebar,
html[data-caprover-theme="glacier"][data-caprover-dark="true"] .navigation-drawer {
    background-color: rgba(19, 44, 59, 0.86);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    html[data-caprover-theme="glacier"] .app-sidebar,
    html[data-caprover-theme="glacier"] .navigation-drawer {
        background: #E5F1F8;
    }
    html[data-caprover-theme="glacier"][data-caprover-dark="true"] .app-sidebar,
    html[data-caprover-theme="glacier"][data-caprover-dark="true"] .navigation-drawer {
        background: #132C3B;
    }
}
@media (prefers-reduced-transparency: reduce) {
    html[data-caprover-theme="glacier"] .app-sidebar,
    html[data-caprover-theme="glacier"] .navigation-drawer {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
        background: #E5F1F8;
    }
    html[data-caprover-theme="glacier"][data-caprover-dark="true"] .app-sidebar,
    html[data-caprover-theme="glacier"][data-caprover-dark="true"] .navigation-drawer {
        background: #132C3B;
    }
}
</style>

