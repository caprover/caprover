###CapRoverTheme.name:
Glacier

###CapRoverTheme.content:
{
    algorithm: isDarkMode ? darkAlgorithm : defaultAlgorithm,
    token: {
        fontFamily: '\'Inter Variable\', Inter, -apple-system, BlinkMacSystemFont, \'Segoe UI\', sans-serif',
        fontFamilyCode: '\'SFMono-Regular\', Consolas, \'Liberation Mono\', monospace',
        fontSize: 14,
        fontWeightStrong: 600,
        colorPrimary: isDarkMode ? '#7DE4F7' : '#006B9B',
        colorPrimaryHover: isDarkMode ? '#90E8F8' : '#00628F',
        colorPrimaryActive: isDarkMode ? '#71D0E2' : '#005A82',
        colorLink: isDarkMode ? '#9EEBF9' : '#006B9B',
        colorLinkHover: isDarkMode ? '#AAEDFA' : '#00628F',
        colorLinkActive: isDarkMode ? '#7DE4F7' : '#005A82',
        colorBgLayout: isDarkMode ? '#081824' : '#EBF4FA',
        colorBgContainer: isDarkMode ? '#112838' : '#F9FDFF',
        colorBgElevated: isDarkMode ? '#1D3B4A' : '#FFFFFF',
        colorBgSpotlight: isDarkMode ? '#1D3B4A' : '#081824',
        colorBgContainerDisabled: isDarkMode ? '#1C3B4B' : '#EAF7FD',
        colorText: isDarkMode ? '#E9F9FF' : '#1D354B',
        colorTextSecondary: isDarkMode ? '#9BC5D8' : '#587186',
