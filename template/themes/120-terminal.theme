###CapRoverTheme.name:
Terminal

###CapRoverTheme.content:
{
    algorithm: isDarkMode ? darkAlgorithm : defaultAlgorithm,
    token: {
        fontFamily: "'JetBrains Mono', Consolas, monospace",
        fontFamilyCode: "'JetBrains Mono', Consolas, monospace",
        fontSize: 13,
        fontSizeHeading1: 30,
        fontSizeHeading2: 24,
        fontSizeHeading3: 22,
        fontSizeHeading4: 18,
        fontSizeHeading5: 15,
        fontWeightStrong: 600,
        colorPrimary: isDarkMode ? '#82E69A' : '#20663B',
        colorPrimaryHover: isDarkMode ? '#95EAA9' : '#1D5E36',
        colorPrimaryActive: isDarkMode ? '#76D08C' : '#1B5632',
        colorLink: isDarkMode ? '#A1ECB3' : '#20663B',
        colorLinkHover: isDarkMode ? '#AEEFBD' : '#1D5E36',
        colorLinkActive: isDarkMode ? '#82E69A' : '#1B5632',
        colorBgLayout: isDarkMode ? '#050D09' : '#F7F8F1',
        colorBgContainer: isDarkMode ? '#0C1811' : '#FFFFF8',
        colorBgElevated: isDarkMode ? '#13231A' : '#FBFFF5',
        colorBgSpotlight: isDarkMode ? '#13231A' : '#050D09',
        colorBgContainerDisabled: isDarkMode ? '#12311E' : '#EEF8E8',
        colorText: isDarkMode ? '#D3F7D5' : '#172A1D',
        colorTextSecondary: isDarkMode ? '#85B58D' : '#586B5C',
        colorTextPlaceholder: isDarkMode ? '#85B58D' : '#586B5C',
        colorTextDisabled: isDarkMode ? '#85B58D' : '#586B5C',
        colorTextLightSolid: '#FFFFFF',
        colorBorder: isDarkMode ? '#295039' : '#BFCFBD',
        colorBorderSecondary: isDarkMode ? '#1E3A2A' : '#D9E4D6',
        colorFillAlter: isDarkMode ? '#12311E' : '#EEF8E8',
        colorBgTextHover: isDarkMode ? '#12311E' : '#EEF8E8',
        colorBgTextActive: isDarkMode ? '#183F26' : '#E4F4DF',
        colorSuccess: isDarkMode ? '#7CE5DD' : '#007184',
        colorSuccessText: isDarkMode ? '#7CE5DD' : '#007184',
        colorSuccessBg: isDarkMode ? '#16372A' : '#E8F5ED',
        colorSuccessBorder: isDarkMode ? '#357757' : '#A7D9BE',
        colorWarning: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningText: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningBg: isDarkMode ? '#3B301C' : '#FFF5DD',
        colorWarningBorder: isDarkMode ? '#8C6931' : '#E5C37C',
        colorError: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorHover: isDarkMode ? '#FF949E' : '#A62032',
        colorErrorActive: isDarkMode ? '#E67580' : '#971D2D',
        colorErrorText: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorBg: isDarkMode ? '#402128' : '#FDEBEC',
        colorErrorBorder: isDarkMode ? '#9A4251' : '#E6A9B1',
        colorInfo: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoText: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoBg: isDarkMode ? '#1B3548' : '#E9F4FE',
        colorInfoBorder: isDarkMode ? '#3D789A' : '#A5C9E7',
        borderRadius: 0,
        borderRadiusLG: 0,
        borderRadiusSM: 0,
        lineWidth: 1,
        lineType: 'solid',
        controlHeight: 30,
        controlOutline: isDarkMode ? '#82E69A' : '#20663B',
        controlOutlineWidth: 2,
        lineWidthFocus: 2,
        controlItemBgHover: isDarkMode ? '#12311E' : '#EEF8E8',
        controlItemBgActive: isDarkMode ? '#183F26' : '#E4F4DF',
        boxShadow: 'none',
        boxShadowSecondary: 'none',
        boxShadowTertiary: 'none',
    },
    components: {
        Layout: {
            headerBg: isDarkMode ? '#0C1811' : '#FFFFF8',
            siderBg: isDarkMode ? '#07130C' : '#EEF2E8',
            lightSiderBg: isDarkMode ? '#07130C' : '#EEF2E8',
            triggerBg: isDarkMode ? '#07130C' : '#EEF2E8',
            lightTriggerBg: isDarkMode ? '#07130C' : '#EEF2E8',
            footerBg: isDarkMode ? '#07130C' : '#EEF2E8',
        },
        Menu: {
            itemBg: 'transparent',
            popupBg: isDarkMode ? '#13231A' : '#FBFFF5',
            itemColor: isDarkMode ? '#D3F7D5' : '#172A1D',
            itemHoverBg: isDarkMode ? '#12311E' : '#EEF8E8',
            itemHoverColor: isDarkMode ? '#D3F7D5' : '#172A1D',
            itemSelectedBg: isDarkMode ? '#183F26' : '#E4F4DF',
            itemSelectedColor: isDarkMode ? '#82E69A' : '#20663B',
            itemHeight: 30,
            itemMarginInline: 4,
            itemMarginBlock: 2,
            itemBorderRadius: 0,
        },
        Tree: {
            titleHeight: 26,
            nodeHoverBg: isDarkMode ? '#12311E' : '#EEF8E8',
            nodeHoverColor: isDarkMode ? '#D3F7D5' : '#172A1D',
            nodeSelectedBg: isDarkMode ? '#183F26' : '#E4F4DF',
            nodeSelectedColor: isDarkMode ? '#82E69A' : '#20663B',
            directoryNodeSelectedBg: isDarkMode ? '#183F26' : '#E4F4DF',
            directoryNodeSelectedColor: isDarkMode ? '#82E69A' : '#20663B',
        },
        Card: {
            headerBg: isDarkMode ? '#0C1811' : '#FFFFF8',
            headerHeight: 48,
            headerFontSize: 15,
            bodyPadding: 16,
            headerPadding: 16,
            extraColor: isDarkMode ? '#85B58D' : '#586B5C',
        },
        Table: {
            headerBg: isDarkMode ? '#050D09' : '#F7F8F1',
            headerColor: isDarkMode ? '#85B58D' : '#586B5C',
            headerSplitColor: isDarkMode ? '#1E3A2A' : '#D9E4D6',
            borderColor: isDarkMode ? '#1E3A2A' : '#D9E4D6',
            rowHoverBg: isDarkMode ? '#12311E' : '#EEF8E8',
            rowSelectedBg: isDarkMode ? '#183F26' : '#E4F4DF',
            rowSelectedHoverBg: isDarkMode ? '#183F26' : '#E4F4DF',
            bodySortBg: 'transparent',
            headerSortActiveBg: isDarkMode ? '#12311E' : '#EEF8E8',
            cellPaddingBlockMD: 8,
            cellPaddingInlineMD: 12,
        },
        Button: {
            fontWeight: 500,
            dangerColor: isDarkMode ? '#050D09' : '#FFFFFF',
            primaryColor: isDarkMode ? '#050D09' : '#FFFFFF',
            primaryShadow: 'none',
            defaultShadow: 'none',
            dangerShadow: 'none',
            defaultBg: isDarkMode ? '#0C1811' : '#FFFFF8',
            defaultColor: isDarkMode ? '#D3F7D5' : '#172A1D',
            defaultBorderColor: isDarkMode ? '#295039' : '#BFCFBD',
            defaultHoverColor: isDarkMode ? '#82E69A' : '#20663B',
            defaultHoverBorderColor: isDarkMode ? '#82E69A' : '#20663B',
            defaultActiveColor: isDarkMode ? '#82E69A' : '#20663B',
            defaultActiveBorderColor: isDarkMode ? '#82E69A' : '#20663B',
            paddingInline: 12,
        },
        Input: {
            activeBg: isDarkMode ? '#0C1811' : '#FFFFF8',
            hoverBg: isDarkMode ? '#0C1811' : '#FFFFF8',
            addonBg: isDarkMode ? '#12311E' : '#EEF8E8',
            hoverBorderColor: isDarkMode ? '#82E69A' : '#20663B',
            activeBorderColor: isDarkMode ? '#82E69A' : '#20663B',
            activeShadow: isDarkMode ? '0 0 0 2px rgba(130,230,154,0.5)' : '0 0 0 2px rgba(32,102,59,0.42)',
        },
        Select: {
            selectorBg: isDarkMode ? '#0C1811' : '#FFFFF8',
            optionSelectedBg: isDarkMode ? '#183F26' : '#E4F4DF',
            optionSelectedColor: isDarkMode ? '#82E69A' : '#20663B',
            optionActiveBg: isDarkMode ? '#12311E' : '#EEF8E8',
            hoverBorderColor: isDarkMode ? '#82E69A' : '#20663B',
            activeBorderColor: isDarkMode ? '#82E69A' : '#20663B',
            activeOutlineColor: isDarkMode ? '#82E69A' : '#20663B',
        },
        Tabs: {
            titleFontSize: 13,
            horizontalItemGutter: 22,
            inkBarColor: isDarkMode ? '#82E69A' : '#20663B',
            itemSelectedColor: isDarkMode ? '#82E69A' : '#20663B',
            itemHoverColor: isDarkMode ? '#82E69A' : '#20663B',
        },
        Tag: {
            defaultBg: isDarkMode ? '#12311E' : '#EEF8E8',
            defaultColor: isDarkMode ? '#D3F7D5' : '#172A1D',
        },
        Form: {
            labelColor: isDarkMode ? '#D3F7D5' : '#172A1D',
            itemMarginBottom: 16,
        },
        Modal: {
            headerBg: isDarkMode ? '#13231A' : '#FBFFF5',
            contentBg: isDarkMode ? '#13231A' : '#FBFFF5',
            footerBg: isDarkMode ? '#13231A' : '#FBFFF5',
            titleColor: isDarkMode ? '#D3F7D5' : '#172A1D',
            titleFontSize: 18,
            paddingMD: 16,
            paddingContentHorizontalLG: 16,
        },
        Alert: {
            defaultPadding: '10px 14px',
            withDescriptionPadding: '16px 20px',
        },
        Badge: {
            statusSize: 7,
        },
    },
}

###CapRoverTheme.headEmbed:
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&amp;display=swap" />
<style>
html[data-caprover-theme="terminal"] {
    --caprover-shell-radius: 0px;
    --caprover-surface-radius: 0px;
    --caprover-control-radius: 0px;
    --caprover-border-width: 1px;
    --caprover-surface-shadow: none;
    --caprover-heading-tracking: 0;
    --caprover-heading-weight: 600;
}
html[data-caprover-theme="terminal"] .page-heading h1,
html[data-caprover-theme="terminal"] .apps-heading h1,
html[data-caprover-theme="terminal"] .app-details-heading h2 {
    font-family: 'JetBrains Mono', Arial, sans-serif;
    font-size: clamp(22px, 2.6vw, 22px);
    line-height: 1.2;
}
html[data-caprover-theme="terminal"] .app-shell.full-screen {
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
}
html[data-caprover-theme="terminal"] .workspace-header,
html[data-caprover-theme="terminal"] .sidebar-brand {
    height: 36px;
    font-size: 12px;
}
html[data-caprover-theme="terminal"] .sidebar-brand {
    font-size: 14px;
}
html[data-caprover-theme="terminal"] .sidebar-section-label,
html[data-caprover-theme="terminal"] .sidebar-content .ant-menu-item-group-title {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 11px;
}
html[data-caprover-theme="terminal"] .sidebar-content .ant-menu-item {
    font-size: 12px;
}
html[data-caprover-theme="terminal"] .sidebar-content .ant-menu-item-selected {
    border: 1px solid var(--ant-color-primary);
}
html[data-caprover-theme="terminal"] #main-content-layout {
    padding: 20px;
}
html[data-caprover-theme="terminal"] .apps-heading h1,
html[data-caprover-theme="terminal"] .page-heading h1 {
    text-transform: uppercase;
    font-size: 22px;
    letter-spacing: 0.04em;
}
html[data-caprover-theme="terminal"] .apps-page > .ant-card-head {
    border-bottom: 1px solid var(--ant-color-primary);
    padding-bottom: 16px;
    margin-bottom: 16px;
}
html[data-caprover-theme="terminal"] .apps-page .ant-table-wrapper {
    border: 0;
}
html[data-caprover-theme="terminal"] .apps-page .ant-table-thead > tr > th {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--ant-color-primary);
}
html[data-caprover-theme="terminal"] .apps-page .ant-table-tbody > tr > td {
    border-bottom: 1px dashed var(--ant-color-border-secondary);
}
html[data-caprover-theme="terminal"] .project-manager .ant-tree {
    border-inline-start: 1px dashed var(--ant-color-border);
}
html[data-caprover-theme="terminal"] .app-details-actions {
    box-shadow: none;
    border-top-color: var(--ant-color-primary);
}
@media (max-width: 767px) {
    html[data-caprover-theme="terminal"] #main-content-layout {
        padding: 24px 16px;
    }
    html[data-caprover-theme="terminal"] .app-shell.full-screen {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        gap: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="terminal"] .workspace-layout {
        border: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="terminal"] .apps-page > .ant-card-head {
        padding: 0 0 20px;
    }
}
</style>

###CapRoverTheme.extra:
{}
