            titleFontSize: 28,
            paddingMD: 26,
            paddingContentHorizontalLG: 26,
        },
        Alert: {
            defaultPadding: '12px 16px',
            withDescriptionPadding: '16px 20px',
        },
        Badge: {
            statusSize: 7,
        },
    },
}

###CapRoverTheme.headEmbed:
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&amp;family=Fredoka:wght@400;500;600;700&amp;display=swap" />
<style>
html[data-caprover-theme="candy-lab"] {
    --caprover-shell-radius: 24px;
    --caprover-surface-radius: 22px;
    --caprover-control-radius: 16px;
    --caprover-border-width: 2px;
    --caprover-surface-shadow: 0 4px 18px rgba(120, 58, 158, 0.08);
    --caprover-heading-tracking: -0.025em;
    --caprover-heading-weight: 600;
}
html[data-caprover-theme="candy-lab"][data-caprover-dark="true"] {
    --caprover-surface-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
}
html[data-caprover-theme="candy-lab"] .page-heading h1,
html[data-caprover-theme="candy-lab"] .apps-heading h1,
html[data-caprover-theme="candy-lab"] .app-details-heading h2 {
    font-family: 'Fredoka', Arial, sans-serif;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.2;
}
html[data-caprover-theme="candy-lab"] .workspace-layout,
html[data-caprover-theme="candy-lab"] .workspace-content {
    background: var(--ant-color-bg-layout);
}
html[data-caprover-theme="candy-lab"] .workspace-header {
    height: 64px;
    border-bottom: 2px solid var(--ant-color-border);
}
html[data-caprover-theme="candy-lab"] .app-sidebar .sidebar-content {
    margin: 12px;
    height: calc(100% - 24px);
    overflow-y: auto;
    border: 2px solid var(--ant-color-text);
    border-radius: 22px;
    background: var(--ant-color-bg-container);
    box-shadow: 4px 4px 0 var(--ant-color-border);
}
html[data-caprover-theme="candy-lab"] .app-sidebar.ant-layout-sider-collapsed .sidebar-content {
    margin: 0;
    height: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}
html[data-caprover-theme="candy-lab"] .sidebar-brand {
    font-family: 'Fredoka', sans-serif;
    font-size: 24px;
    height: 64px;
}
html[data-caprover-theme="candy-lab"] .sidebar-content .ant-menu-item {
    font-weight: 700;
}
html[data-caprover-theme="candy-lab"] .sidebar-content .ant-menu-item-selected {
    border: 2px solid var(--ant-color-primary);
}
html[data-caprover-theme="candy-lab"] #main-content-layout {
    padding: 32px;
}
html[data-caprover-theme="candy-lab"] .apps-page > .ant-card-head {
    margin-bottom: 30px;
}
html[data-caprover-theme="candy-lab"] .apps-page .ant-table-wrapper {
    border: 2px solid var(--ant-color-text);
    box-shadow: 5px 5px 0 var(--ant-color-border);
}
html[data-caprover-theme="candy-lab"] .apps-page .ant-table-thead > tr > th {
    font-family: 'Fredoka', sans-serif;
    font-size: 17px;
    font-weight: 500;
}
html[data-caprover-theme="candy-lab"] .ant-btn-primary {
    box-shadow: 0 4px 0 var(--ant-color-primary-active);
    font-weight: 700;
}
html[data-caprover-theme="candy-lab"] .ant-btn-primary:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--ant-color-primary-active);
}
html[data-caprover-theme="candy-lab"] .count-badge {
    border: 2px solid var(--ant-color-primary);
    min-width: 28px;
    height: 28px;
    justify-content: center;
    font-family: 'Fredoka', sans-serif;
}
html[data-caprover-theme="candy-lab"] .form-section-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 23px;
}
html[data-caprover-theme="candy-lab"] .ant-modal-content {
    border: 2px solid var(--ant-color-text);
}
html[data-caprover-theme="candy-lab"] .ant-modal-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 28px;
}
@media (max-width: 767px) {
    html[data-caprover-theme="candy-lab"] #main-content-layout {
        padding: 24px 16px;
    }
    html[data-caprover-theme="candy-lab"] .app-shell.full-screen {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        gap: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="candy-lab"] .workspace-layout {
        border: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="candy-lab"] .apps-page > .ant-card-head {
        padding: 0 0 20px;
    }
}
</style>

###CapRoverTheme.extra:
{}
