###CapRoverTheme.name:
Aurora

###CapRoverTheme.content:
{
    algorithm: isDarkMode ? darkAlgorithm : defaultAlgorithm,
    token: {
        fontFamily: "'DM Sans', Arial, sans-serif",
        fontFamilyCode: "'SFMono-Regular', Consolas, monospace",
        fontSize: 14,
        fontSizeHeading1: 42,
        fontSizeHeading2: 36,
        fontSizeHeading3: 34,
        fontSizeHeading4: 30,
        fontSizeHeading5: 16,
        fontWeightStrong: 600,
        colorPrimary: isDarkMode ? '#AB94FF' : '#5549BF',
        colorPrimaryHover: isDarkMode ? '#B8A4FF' : '#4E43B0',
        colorPrimaryActive: isDarkMode ? '#9C87EA' : '#473DA0',
        colorLink: isDarkMode ? '#C0AFFF' : '#5549BF',
        colorLinkHover: isDarkMode ? '#C8B9FF' : '#4E43B0',
        colorLinkActive: isDarkMode ? '#AB94FF' : '#473DA0',
        colorBgLayout: isDarkMode ? '#111328' : '#F7F4FC',
        colorBgContainer: isDarkMode ? '#1C1D3A' : '#FFFEFF',
        colorBgElevated: isDarkMode ? '#28294A' : '#FFFFFF',
        colorBgSpotlight: isDarkMode ? '#28294A' : '#111328',
        colorBgContainerDisabled: isDarkMode ? '#2B2A4D' : '#F1EDFC',
        colorText: isDarkMode ? '#F0EDFF' : '#27233D',
        colorTextSecondary: isDarkMode ? '#B2ACCD' : '#675F7F',
        colorTextPlaceholder: isDarkMode ? '#B2ACCD' : '#675F7F',
        colorTextDisabled: isDarkMode ? '#B2ACCD' : '#675F7F',
        colorTextLightSolid: '#FFFFFF',
        colorBorder: isDarkMode ? '#3E3B63' : '#DDD5EA',
        colorBorderSecondary: isDarkMode ? '#322F52' : '#EAE4F3',
        colorFillAlter: isDarkMode ? '#2B2A4D' : '#F1EDFC',
        colorBgTextHover: isDarkMode ? '#2B2A4D' : '#F1EDFC',
        colorBgTextActive: isDarkMode ? '#33305B' : '#ECE7FB',
        colorSuccess: isDarkMode ? '#6ADEAE' : '#1E7452',
        colorSuccessText: isDarkMode ? '#6ADEAE' : '#1E7452',
        colorSuccessBg: isDarkMode ? '#16372A' : '#E8F5ED',
        colorSuccessBorder: isDarkMode ? '#357757' : '#A7D9BE',
        colorWarning: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningText: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningBg: isDarkMode ? '#3B301C' : '#FFF5DD',
        colorWarningBorder: isDarkMode ? '#8C6931' : '#E5C37C',
        colorError: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorHover: isDarkMode ? '#FF949E' : '#A62032',
        colorErrorActive: isDarkMode ? '#E77683' : '#971D2D',
        colorErrorText: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorBg: isDarkMode ? '#402128' : '#FDEBEC',
        colorErrorBorder: isDarkMode ? '#9A4251' : '#E6A9B1',
        colorInfo: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoText: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoBg: isDarkMode ? '#1B3548' : '#E9F4FE',
        colorInfoBorder: isDarkMode ? '#3D789A' : '#A5C9E7',
        borderRadius: 18,
        borderRadiusLG: 20,
        borderRadiusSM: 10,
        lineWidth: 1,
        lineType: 'solid',
        controlHeight: 40,
        controlOutline: isDarkMode ? '#AB94FF' : '#5549BF',
        controlOutlineWidth: 2,
        lineWidthFocus: 2,
        controlItemBgHover: isDarkMode ? '#2B2A4D' : '#F1EDFC',
        controlItemBgActive: isDarkMode ? '#33305B' : '#ECE7FB',
        boxShadow: isDarkMode ? '0 22px 56px rgba(0,0,0,0.46)' : '0 20px 48px rgba(71,53,121,0.20)',
        boxShadowSecondary: isDarkMode ? '0 22px 56px rgba(0,0,0,0.46)' : '0 20px 48px rgba(71,53,121,0.20)',
        boxShadowTertiary: isDarkMode ? '0 8px 28px rgba(6,4,24,0.30)' : '0 6px 24px rgba(85,73,191,0.10)',
    },
    components: {
        Layout: {
            headerBg: isDarkMode ? '#1C1D3A' : '#FFFEFF',
            siderBg: isDarkMode ? '#151735' : '#F1EDFA',
            lightSiderBg: isDarkMode ? '#151735' : '#F1EDFA',
            triggerBg: isDarkMode ? '#151735' : '#F1EDFA',
            lightTriggerBg: isDarkMode ? '#151735' : '#F1EDFA',
            footerBg: isDarkMode ? '#151735' : '#F1EDFA',
        },
        Menu: {
            itemBg: 'transparent',
            popupBg: isDarkMode ? '#28294A' : '#FFFFFF',
            itemColor: isDarkMode ? '#F0EDFF' : '#27233D',
            itemHoverBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            itemHoverColor: isDarkMode ? '#F0EDFF' : '#27233D',
            itemSelectedBg: isDarkMode ? '#33305B' : '#ECE7FB',
            itemSelectedColor: isDarkMode ? '#AB94FF' : '#5549BF',
            itemHeight: 42,
            itemMarginInline: 8,
            itemMarginBlock: 2,
            itemBorderRadius: 18,
        },
        Tree: {
            titleHeight: 38,
            nodeHoverBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            nodeHoverColor: isDarkMode ? '#F0EDFF' : '#27233D',
            nodeSelectedBg: isDarkMode ? '#33305B' : '#ECE7FB',
            nodeSelectedColor: isDarkMode ? '#AB94FF' : '#5549BF',
            directoryNodeSelectedBg: isDarkMode ? '#33305B' : '#ECE7FB',
            directoryNodeSelectedColor: isDarkMode ? '#AB94FF' : '#5549BF',
        },
        Card: {
            headerBg: isDarkMode ? '#1C1D3A' : '#FFFEFF',
            headerHeight: 52,
            headerFontSize: 15,
            bodyPadding: 24,
            headerPadding: 24,
            extraColor: isDarkMode ? '#B2ACCD' : '#675F7F',
        },
        Table: {
            headerBg: isDarkMode ? '#111328' : '#F7F4FC',
            headerColor: isDarkMode ? '#B2ACCD' : '#675F7F',
            headerSplitColor: isDarkMode ? '#322F52' : '#EAE4F3',
            borderColor: isDarkMode ? '#322F52' : '#EAE4F3',
            rowHoverBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            rowSelectedBg: isDarkMode ? '#33305B' : '#ECE7FB',
            rowSelectedHoverBg: isDarkMode ? '#33305B' : '#ECE7FB',
            bodySortBg: 'transparent',
            headerSortActiveBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            cellPaddingBlockMD: 16,
            cellPaddingInlineMD: 16,
        },
        Button: {
            fontWeight: 500,
            dangerColor: isDarkMode ? '#111328' : '#FFFFFF',
            primaryColor: isDarkMode ? '#111328' : '#FFFFFF',
            primaryShadow: 'none',
            defaultShadow: 'none',
            dangerShadow: 'none',
            defaultBg: isDarkMode ? '#1C1D3A' : '#FFFEFF',
            defaultColor: isDarkMode ? '#F0EDFF' : '#27233D',
            defaultBorderColor: isDarkMode ? '#3E3B63' : '#DDD5EA',
            defaultHoverColor: isDarkMode ? '#AB94FF' : '#5549BF',
            defaultHoverBorderColor: isDarkMode ? '#AB94FF' : '#5549BF',
            defaultActiveColor: isDarkMode ? '#AB94FF' : '#5549BF',
            defaultActiveBorderColor: isDarkMode ? '#AB94FF' : '#5549BF',
            paddingInline: 14,
        },
        Input: {
            activeBg: isDarkMode ? '#1C1D3A' : '#FFFEFF',
            hoverBg: isDarkMode ? '#1C1D3A' : '#FFFEFF',
            addonBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            hoverBorderColor: isDarkMode ? '#AB94FF' : '#5549BF',
            activeBorderColor: isDarkMode ? '#AB94FF' : '#5549BF',
            activeShadow: isDarkMode ? '0 0 0 3px rgba(171,148,255,0.25)' : '0 0 0 3px rgba(85,73,191,0.23)',
        },
        Select: {
            selectorBg: isDarkMode ? '#1C1D3A' : '#FFFEFF',
            optionSelectedBg: isDarkMode ? '#33305B' : '#ECE7FB',
            optionSelectedColor: isDarkMode ? '#AB94FF' : '#5549BF',
            optionActiveBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            hoverBorderColor: isDarkMode ? '#AB94FF' : '#5549BF',
            activeBorderColor: isDarkMode ? '#AB94FF' : '#5549BF',
            activeOutlineColor: isDarkMode ? '#AB94FF' : '#5549BF',
        },
        Tabs: {
            titleFontSize: 14,
            horizontalItemGutter: 26,
            inkBarColor: isDarkMode ? '#AB94FF' : '#5549BF',
            itemSelectedColor: isDarkMode ? '#AB94FF' : '#5549BF',
            itemHoverColor: isDarkMode ? '#AB94FF' : '#5549BF',
        },
        Tag: {
            defaultBg: isDarkMode ? '#2B2A4D' : '#F1EDFC',
            defaultColor: isDarkMode ? '#F0EDFF' : '#27233D',
        },
        Form: {
            labelColor: isDarkMode ? '#F0EDFF' : '#27233D',
            itemMarginBottom: 22,
        },
        Modal: {
            headerBg: isDarkMode ? '#28294A' : '#FFFFFF',
            contentBg: isDarkMode ? '#28294A' : '#FFFFFF',
            footerBg: isDarkMode ? '#28294A' : '#FFFFFF',
            titleColor: isDarkMode ? '#F0EDFF' : '#27233D',
            titleFontSize: 18,
            paddingMD: 24,
            paddingContentHorizontalLG: 24,
        },
        Alert: {
            defaultPadding: '12px 16px',
            withDescriptionPadding: '16px 20px',
        },
        Badge: {
            statusSize: 7,
        },
    },
}

###CapRoverTheme.headEmbed:
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap" />
<style>
html[data-caprover-theme="aurora"] {
    --caprover-shell-radius: 20px;
    --caprover-surface-radius: 16px;
    --caprover-control-radius: 18px;
    --caprover-border-width: 1px;
    --caprover-surface-shadow: 0 4px 16px rgba(85, 73, 191, 0.06);
    --caprover-heading-tracking: -0.045em;
    --caprover-heading-weight: 600;
}
html[data-caprover-theme="aurora"][data-caprover-dark="true"] {
    --caprover-surface-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
}
html[data-caprover-theme="aurora"] .workspace-layout {
    background-image:
        radial-gradient(circle at 12% 0%, rgba(112, 83, 201, 0.08), transparent 38%),
        radial-gradient(circle at 100% 100%, rgba(31, 155, 155, 0.05), transparent 40%);
}
html[data-caprover-theme="aurora"][data-caprover-dark="true"] .workspace-layout {
    background-image:
        radial-gradient(circle at 8% 0%, rgba(134, 95, 239, 0.10), transparent 40%),
        radial-gradient(circle at 100% 90%, rgba(40, 175, 160, 0.07), transparent 42%);
}
html[data-caprover-theme="aurora"] .workspace-content {
    background: transparent;
}
html[data-caprover-theme="aurora"] .page-heading h1,
html[data-caprover-theme="aurora"] .apps-heading h1,
html[data-caprover-theme="aurora"] .app-details-heading h2 {
    font-family: 'Space Grotesk', Arial, sans-serif;
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.2;
}
html[data-caprover-theme="aurora"] .workspace-header {
    height: 56px;
    font-family: 'Space Grotesk', sans-serif;
}
html[data-caprover-theme="aurora"] .sidebar-brand {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 21px;
    height: 56px;
}
html[data-caprover-theme="aurora"] .sidebar-content .ant-menu-item {
    font-family: 'Space Grotesk', sans-serif;
}
html[data-caprover-theme="aurora"] .sidebar-content .ant-menu-item-selected {
    border: 1px solid var(--ant-color-primary);
    box-shadow: 0 0 20px rgba(134,95,239,0.14);
}
html[data-caprover-theme="aurora"] .apps-page > .ant-card-head {
    padding: 22px;
    border: 1px solid var(--ant-color-primary-border);
    border-radius: 16px;
    background: var(--ant-color-primary-bg);
    margin-bottom: 28px;
}
html[data-caprover-theme="aurora"] .apps-page .ant-table-thead > tr > th {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    letter-spacing: 0.02em;
}
html[data-caprover-theme="aurora"] .metric-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 34px;
}
html[data-caprover-theme="aurora"] .ant-input-affix-wrapper,
html[data-caprover-theme="aurora"] .ant-select-selector {
    border-radius: 12px;
}
html[data-caprover-theme="aurora"] .app-details-actions {
    border-color: var(--ant-color-primary-border);
}
@media (max-width: 767px) {
    html[data-caprover-theme="aurora"] #main-content-layout {
        padding: 24px 16px;
    }
    html[data-caprover-theme="aurora"] .app-shell.full-screen {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        gap: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="aurora"] .workspace-layout {
        border: 0;
        border-radius: 0;
    }
    html[data-caprover-theme="aurora"] .apps-page > .ant-card-head {
        padding: 16px;
    }
}
</style>

###CapRoverTheme.extra:
{}
