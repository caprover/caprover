###CapRoverTheme.name:
Carbon

###CapRoverTheme.content:
{
    algorithm: isDarkMode ? darkAlgorithm : defaultAlgorithm,
    token: {
        fontFamily: '\'Inter Variable\', Inter, -apple-system, BlinkMacSystemFont, \'Segoe UI\', sans-serif',
        fontFamilyCode: '\'SFMono-Regular\', Consolas, \'Liberation Mono\', monospace',
        fontSize: 14,
        fontWeightStrong: 600,
        colorPrimary: isDarkMode ? '#AA9ACA' : '#675C89',
        colorPrimaryHover: isDarkMode ? '#B7A9D2' : '#5F557E',
        colorPrimaryActive: isDarkMode ? '#9B8CB8' : '#574D73',
        colorLink: isDarkMode ? '#BFB3D7' : '#675C89',
        colorLinkHover: isDarkMode ? '#C8BDDD' : '#5F557E',
        colorLinkActive: isDarkMode ? '#AA9ACA' : '#574D73',
        colorBgLayout: isDarkMode ? '#111216' : '#F3F4F7',
        colorBgContainer: isDarkMode ? '#1A1C21' : '#FFFFFF',
        colorBgElevated: isDarkMode ? '#24262D' : '#FAFAFC',
        colorBgSpotlight: isDarkMode ? '#24262D' : '#111216',
        colorBgContainerDisabled: isDarkMode ? '#282830' : '#F0EEF5',
        colorText: isDarkMode ? '#EDEEF2' : '#20232B',
        colorTextSecondary: isDarkMode ? '#A5A7B2' : '#626875',
        colorTextPlaceholder: isDarkMode ? '#A5A7B2' : '#626875',
        colorTextDisabled: isDarkMode ? '#A5A7B2' : '#626875',
        colorTextLightSolid: '#FFFFFF',
        colorBorder: isDarkMode ? '#373944' : '#D8DBE2',
        colorBorderSecondary: isDarkMode ? '#2D3038' : '#E5E7EC',
        colorFillAlter: isDarkMode ? '#282830' : '#F0EEF5',
        colorBgTextHover: isDarkMode ? '#282830' : '#F0EEF5',
        colorBgTextActive: isDarkMode ? '#2D2938' : '#E9E5F3',
        colorSuccess: isDarkMode ? '#6ADEAE' : '#1E7452',
        colorSuccessText: isDarkMode ? '#6ADEAE' : '#1E7452',
        colorSuccessBg: isDarkMode ? '#16372A' : '#E8F5ED',
        colorSuccessBorder: isDarkMode ? '#357757' : '#A7D9BE',
        colorWarning: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningText: isDarkMode ? '#FFCC70' : '#9A6200',
        colorWarningBg: isDarkMode ? '#3B301C' : '#FFF5DD',
        colorWarningBorder: isDarkMode ? '#8C6931' : '#E5C37C',
        colorError: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorHover: isDarkMode ? '#FF949E' : '#A62032',
        colorErrorActive: isDarkMode ? '#E77681' : '#971D2D',
        colorErrorText: isDarkMode ? '#FF818D' : '#B42336',
        colorErrorBg: isDarkMode ? '#402128' : '#FDEBEC',
        colorErrorBorder: isDarkMode ? '#9A4251' : '#E6A9B1',
        colorInfo: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoText: isDarkMode ? '#79C5FF' : '#1665A8',
        colorInfoBg: isDarkMode ? '#1B3548' : '#E9F4FE',
        colorInfoBorder: isDarkMode ? '#3D789A' : '#A5C9E7',
        borderRadius: 6,
        borderRadiusLG: 8,
        borderRadiusSM: 4,
        lineWidth: 1,
        lineType: 'solid',
        controlHeight: 36,
        controlOutline: isDarkMode ? '#AA9ACA' : '#675C89',
        controlOutlineWidth: 2,
        lineWidthFocus: 2,
        controlItemBgHover: isDarkMode ? '#282830' : '#F0EEF5',
        controlItemBgActive: isDarkMode ? '#2D2938' : '#E9E5F3',
        boxShadow: isDarkMode ? '0 12px 30px rgba(0,0,0,0.36)' : '0 10px 26px rgba(27,31,39,0.10)',
        boxShadowSecondary: isDarkMode ? '0 12px 30px rgba(0,0,0,0.36)' : '0 10px 26px rgba(27,31,39,0.10)',
        boxShadowTertiary: 'none',
    },
    components: {
        Layout: {
            headerBg: isDarkMode ? '#1A1C21' : '#FFFFFF',
            siderBg: isDarkMode ? '#15171C' : '#ECEEF2',
            lightSiderBg: isDarkMode ? '#15171C' : '#ECEEF2',
            triggerBg: isDarkMode ? '#15171C' : '#ECEEF2',
            lightTriggerBg: isDarkMode ? '#15171C' : '#ECEEF2',
            footerBg: isDarkMode ? '#15171C' : '#ECEEF2',
        },
        Menu: {
            itemBg: 'transparent',
            popupBg: isDarkMode ? '#24262D' : '#FAFAFC',
            itemColor: isDarkMode ? '#EDEEF2' : '#20232B',
            itemHoverBg: isDarkMode ? '#282830' : '#F0EEF5',
            itemHoverColor: isDarkMode ? '#EDEEF2' : '#20232B',
            itemSelectedBg: isDarkMode ? '#2D2938' : '#E9E5F3',
            itemSelectedColor: isDarkMode ? '#AA9ACA' : '#675C89',
            itemHeight: 36,
            itemMarginInline: 8,
            itemMarginBlock: 2,
            itemBorderRadius: 6,
        },
        Tree: {
            titleHeight: 32,
            nodeHoverBg: isDarkMode ? '#282830' : '#F0EEF5',
            nodeHoverColor: isDarkMode ? '#EDEEF2' : '#20232B',
            nodeSelectedBg: isDarkMode ? '#2D2938' : '#E9E5F3',
            nodeSelectedColor: isDarkMode ? '#AA9ACA' : '#675C89',
            directoryNodeSelectedBg: isDarkMode ? '#2D2938' : '#E9E5F3',
            directoryNodeSelectedColor: isDarkMode ? '#AA9ACA' : '#675C89',
        },
        Card: {
            headerBg: isDarkMode ? '#1A1C21' : '#FFFFFF',
            headerHeight: 48,
            headerFontSize: 15,
            bodyPadding: 20,
            headerPadding: 20,
            extraColor: isDarkMode ? '#A5A7B2' : '#626875',
        },
        Table: {
            headerBg: isDarkMode ? '#111216' : '#F3F4F7',
            headerColor: isDarkMode ? '#A5A7B2' : '#626875',
            headerSplitColor: isDarkMode ? '#2D3038' : '#E5E7EC',
            borderColor: isDarkMode ? '#2D3038' : '#E5E7EC',
            rowHoverBg: isDarkMode ? '#282830' : '#F0EEF5',
            rowSelectedBg: isDarkMode ? '#2D2938' : '#E9E5F3',
            rowSelectedHoverBg: isDarkMode ? '#2D2938' : '#E9E5F3',
            bodySortBg: 'transparent',
            headerSortActiveBg: isDarkMode ? '#282830' : '#F0EEF5',
            cellPaddingBlockMD: 12,
            cellPaddingInlineMD: 16,
        },
        Button: {
            fontWeight: 500,
            dangerColor: isDarkMode ? '#111216' : '#FFFFFF',
            primaryColor: isDarkMode ? '#111216' : '#FFFFFF',
            primaryShadow: 'none',
            defaultShadow: 'none',
            dangerShadow: 'none',
            defaultBg: isDarkMode ? '#1A1C21' : '#FFFFFF',
            defaultColor: isDarkMode ? '#EDEEF2' : '#20232B',
            defaultBorderColor: isDarkMode ? '#373944' : '#D8DBE2',
            defaultHoverColor: isDarkMode ? '#AA9ACA' : '#675C89',
            defaultHoverBorderColor: isDarkMode ? '#AA9ACA' : '#675C89',
            defaultActiveColor: isDarkMode ? '#AA9ACA' : '#675C89',
            defaultActiveBorderColor: isDarkMode ? '#AA9ACA' : '#675C89',
            paddingInline: 12,
        },
        Input: {
            activeBg: isDarkMode ? '#1A1C21' : '#FFFFFF',
            hoverBg: isDarkMode ? '#1A1C21' : '#FFFFFF',
            addonBg: isDarkMode ? '#282830' : '#F0EEF5',
            hoverBorderColor: isDarkMode ? '#AA9ACA' : '#675C89',
            activeBorderColor: isDarkMode ? '#AA9ACA' : '#675C89',
            activeShadow: isDarkMode ? '0 0 0 3px rgba(170,154,202,0.25)' : '0 0 0 3px rgba(103,92,137,0.23)',
        },
        Select: {
            selectorBg: isDarkMode ? '#1A1C21' : '#FFFFFF',
            optionSelectedBg: isDarkMode ? '#2D2938' : '#E9E5F3',
            optionSelectedColor: isDarkMode ? '#AA9ACA' : '#675C89',
            optionActiveBg: isDarkMode ? '#282830' : '#F0EEF5',
            hoverBorderColor: isDarkMode ? '#AA9ACA' : '#675C89',
            activeBorderColor: isDarkMode ? '#AA9ACA' : '#675C89',
            activeOutlineColor: isDarkMode ? '#AA9ACA' : '#675C89',
        },
        Tabs: {
            titleFontSize: 14,
            horizontalItemGutter: 22,
            inkBarColor: isDarkMode ? '#AA9ACA' : '#675C89',
            itemSelectedColor: isDarkMode ? '#AA9ACA' : '#675C89',
            itemHoverColor: isDarkMode ? '#AA9ACA' : '#675C89',
        },
        Tag: {
            defaultBg: isDarkMode ? '#282830' : '#F0EEF5',
            defaultColor: isDarkMode ? '#EDEEF2' : '#20232B',
        },
        Form: {
            labelColor: isDarkMode ? '#EDEEF2' : '#20232B',
            itemMarginBottom: 18,
        },
        Modal: {
            headerBg: isDarkMode ? '#24262D' : '#FAFAFC',
            contentBg: isDarkMode ? '#24262D' : '#FAFAFC',
            footerBg: isDarkMode ? '#24262D' : '#FAFAFC',
            titleColor: isDarkMode ? '#EDEEF2' : '#20232B',
            titleFontSize: 16,
            paddingMD: 20,
            paddingContentHorizontalLG: 20,
        },
        Alert: {
            defaultPadding: '10px 14px',
            withDescriptionPadding: '16px 20px',
        },
        Badge: {
            statusSize: 7,
        },
    },
}

###CapRoverTheme.headEmbed:
<style>
html[data-caprover-theme="carbon"] {
    --caprover-shell-radius: 8px;
    --caprover-surface-radius: 6px;
    --caprover-control-radius: 4px;
    --caprover-border-width: 1px;
    --caprover-surface-shadow: none;
    --caprover-heading-tracking: -0.025em;
    --caprover-heading-weight: 600;
}
</style>

###CapRoverTheme.extra:
{}
